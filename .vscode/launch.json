{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_ENV": "development",
            },
            "args": [
                "run",
                "--debug",
            ],
            "jinja": true
        },
        {
            "name": "Run Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "run",
            ],
            "jinja": true
        },
        {
            "name": "App Test",
            "type": "debugpy",
            "request": "launch",
            "program": "tests.py",
            "console": "integratedTerminal"
        },
    ]
}